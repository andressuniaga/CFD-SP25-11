8
(
    inlet
    {
        type            patch;
        nFaces          0;
        startFace       2014;
    }
    outlet
    {
        type            patch;
        nFaces          97;
        startFace       2014;
    }
    cylinder
    {
        type            wall;
        inGroups        List<word> 1(wall);
        nFaces          0;
        startFace       2111;
    }
    top
    {
        type            symmetryPlane;
        inGroups        List<word> 1(symmetryPlane);
        nFaces          0;
        startFace       2111;
    }
    bottom
    {
        type            symmetryPlane;
        inGroups        List<word> 1(symmetryPlane);
        nFaces          11;
        startFace       2111;
    }
    defaultFaces
    {
        type            empty;
        inGroups        List<word> 1(empty);
        nFaces          2124;
        startFace       2122;
    }
    procBoundary15to14
    {
        type            processor;
        inGroups        List<word> 1(processor);
        nFaces          100;
        startFace       4246;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        15;
        neighbProcNo    14;
    }
    procBoundary15to31
    {
        type            processor;
        inGroups        List<word> 1(processor);
        nFaces          12;
        startFace       4346;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        15;
        neighbProcNo    31;
    }
)

